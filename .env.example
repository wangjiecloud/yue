# Copy to .env locally. Never commit real secrets.

# --- Internal DeepSeek-compatible endpoint (image understanding + planning) ---
# OpenAI-compatible base URL, e.g. http://host:port/v1
YUE_DEEPSEEK_BASE_URL=
# Server-side credential. Never expose to browser, APK or course packages.
YUE_DEEPSEEK_API_KEY=
# Model id sent in the request payload.
YUE_DEEPSEEK_MODEL=deepseek-v4.1-flash
# Workspace/consumer label used by the gateway, if required.
YUE_DEEPSEEK_WORKSPACE=
YUE_DEEPSEEK_TIMEOUT_S=120

# --- Local CosyVoice3 (FunAudioLLM/Fun-CosyVoice3-0.5B-2512) ---
# Directory containing the downloaded weights and CosyVoice runtime checkout.
YUE_COSYVOICE_MODEL_DIR=
YUE_COSYVOICE_REFERENCE_AUDIO=
YUE_COSYVOICE_REFERENCE_TEXT=
YUE_COSYVOICE_DEVICE=auto

# --- Runtime ---
# Data directory for uploads, jobs, rendered videos and reports.
YUE_DATA_DIR=./data
# Placeholder macOS `say` audio is ONLY for engineering probes, never for
# accepted courses. Keep disabled unless explicitly running a render probe.
YUE_ALLOW_PLACEHOLDER_TTS=0
